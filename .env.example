# Exchange credentials (placeholders only, never commit real values)
LUNO_KEY=your-luno-api-key-id
LUNO_SECRET=your-luno-api-secret
FTX_KEY=your-slave-exchange-api-key
FTX_SECRET=your-slave-exchange-api-secret
# Optional sub-account name (no spaces)
FTX_SUBACCOUNT_NAME_NOSPACE=

# Strategy parameters
ASSETS=BTC,ETH,LTC
# Minimum combined premium (percent) required to trade
SAFE_GAP_PERCENT=0.5
# Hard floor for SAFE_GAP_PERCENT; the bot refuses to start below it (default 0.2)
MIN_SAFE_GAP_PERCENT=0.2
# Order size in quote currency of the master venue
ORDER_SIZE_MYR=500
# Pause between cycles in milliseconds
CYCLE_TIME_MS=3000
# Optional fixed USDT/quote rate; if empty it is fetched from a public price API
USDTMYR=4.20
